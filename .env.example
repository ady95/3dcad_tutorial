# .env.example 을 .env 로 복사한 뒤 본인의 키를 입력하세요.
# .env 파일은 절대 커밋하지 마세요 (.gitignore 에 포함되어 있습니다).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-astra

# OpenAI 호환 서버를 쓸 때만 지정합니다. 비워 두면 OpenAI API를 사용합니다.
# 예: 로컬 LLM(vLLM·Ollama 등)과 비교할 때 (부록 A)
#   OPENAI_BASE_URL=http://localhost:8000/v1
#   OPENAI_MODEL=qwen3.8-27b
# OPENAI_BASE_URL=   (빈 값으로 두지 말고 주석 처리 상태로 둘 것 — 빈 문자열은 기본 주소로 대체되지 않음)

# FreeCAD 실행 파일 경로 (FreeCADCmd / freecadcmd). 비워 두면 PATH 에서 찾습니다.
FREECAD_CMD=
